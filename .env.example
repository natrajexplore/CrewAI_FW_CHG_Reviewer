# Copy to .env and fill in. Never commit .env.

# LLM (any CrewAI/LiteLLM model string; the API key must match the provider)
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Mode: offline (sample/exported rulebases). Live read-only API mode is planned (Phase 4).
RULEGATE_MODE=offline
# Optional overrides for offline rulebase exports
# RULEGATE_PANOS_RULEBASE=samples/rulebases/panos_running.xml
# RULEGATE_FMC_RULEBASE=samples/rulebases/fmc_accessrules.json

# Palo Alto - use a READ-ONLY admin role (Phase 4)
PANOS_HOST=
PANOS_API_KEY=
PANOS_DEVICE_GROUP=

# Cisco FMC - use a READ-ONLY user role (Phase 4)
FMC_HOST=
FMC_USERNAME=
FMC_PASSWORD=
FMC_DOMAIN_UUID=
FMC_ACCESS_POLICY=
